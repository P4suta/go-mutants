// Package sample is a golden fixture: results whose declared type is not the
// type of the operand that fills them, which is the type the probe has to
// declare its temporary as.
package sample; import __gm "example.com/mini/gomutants_rt"

// Level is a named integer type.
type Level int

// Half returns an untyped constant as a float, so the temporary has to be a
// float32 and not the int the constant would default to.
func Half() float32 { { var __gm_r0 float32 = 1; if __gm_r0 != 0 { __gm.Infect(0) }; return __gm_r0 } }

// Count returns the same constant through a named result of a named type.
func Count() (n Level) { { var __gm_r0 Level = 1; if __gm_r0 != 0 { __gm.Infect(1) }; return __gm_r0 } }

// Text returns a string, which is the third constant the family compares
// against.
func Text(s string) string { { var __gm_r0 string = s; if __gm_r0 != "" { __gm.Infect(2) }; return __gm_r0 } }
