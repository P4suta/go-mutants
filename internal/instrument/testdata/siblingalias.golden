// Package sample is half of a golden fixture: nothing in this file binds the
// alias the instrumenter reaches for, and two names in the file beside it do.
package sample; import __gm2 "example.com/mini/gomutants_rt"

// Less reports whether a is below b.
func Less(a, b int) bool {
	return (__gm2.M[0] && (a<=b) || !(__gm2.M[0]) && (a < b))
}
