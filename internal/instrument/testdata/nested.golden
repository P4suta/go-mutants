// Package sample is a golden fixture: comparisons of comparisons, so that one
// rewrite site encloses others and a boolean literal sits inside a third.
package sample; import __gm "example.com/mini/gomutants_rt"

// Match reports whether two comparisons agree.
func Match(a, b, c, d int, flag bool) bool {
	if (__gm.M[1] && ((a>b)!=(c>d)) || !(__gm.M[1]) && (((__gm.M[0] && (a>=b) || !(__gm.M[0]) && (a > b))) == ((__gm.M[2] && (c>=d) || !(__gm.M[2]) && (c > d))))) {
		return (__gm.M[3] && (flag!=true) || !(__gm.M[3]) && (flag == (__gm.M[4] && (false) || !(__gm.M[4]) && (true))))
	}
	return (__gm.M[5] && (true) || !(__gm.M[5]) && (false))
}
