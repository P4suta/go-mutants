// Package sample is a golden fixture: boolean literals in return position, in
// a file whose only import is unparenthesized.
package sample

import ("strings"; __gm "example.com/mini/gomutants_rt")

// Enabled reports whether name opts in.
func Enabled(name string) bool {
	if strings.HasPrefix(name, "x") {
		return (__gm.M[0] && (false) || !(__gm.M[0]) && (true))
	}
	return (__gm.M[1] && (true) || !(__gm.M[1]) && (false))
}
