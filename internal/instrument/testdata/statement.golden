// Package sample is a golden fixture: the statement guard, over a return
// carrying two mutants at once, an assignment written across three lines, a
// deferred call, and a statement one of whose mutants deletes it outright.
package sample; import __gm "example.com/mini/gomutants_rt"

// Measure reports the length of s and whatever measuring it went wrong with.
//
// Both returned values are rewrite sites and they share one: the
// return-replacement of the count and the error-swallowing of the failure are
// two alternatives of a single statement guard, because they are two edits to
// one statement.
func Measure(s string) (int, error) {
	count, err := measure(s)
	if __gm.M[0] { return 0,err } else if __gm.M[1] { return count,nil } else { return count, err }
}

// measure is the callee Measure delegates to, and is catalogued nowhere.
func measure(s string) (int, error) {
	return len(s), nil
}

// Accumulate folds every step into total, in an assignment spread over three
// lines so that the guard has to write its own bytes on the first and the last
// of them and nothing in between.
func Accumulate(total int, steps []int) int {
	for _, step := range steps {
		if __gm.M[2] { total=total-step*2-1 } else { total = total +
			step*2 -
			1 }
	}
	return total
}

// Track reports the count as the function returns and then raises it.
//
// The deferred call is wrapped whole rather than having its argument rewritten
// in place: `defer` is function-scoped, so the block the guard adds changes
// nothing about when it fires. The statement after it carries two mutants from
// two different families — one swaps the operator, one deletes the statement —
// which chain as alternatives of one guard all the same.
func Track(counter *int, done func(int)) {
	if __gm.M[3] { defer done(*counter-1) } else { defer done(*counter + 1) }
	if __gm.M[4] { } else if __gm.M[5] { *counter= *counter-2 } else { *counter = *counter + 2 }
}
