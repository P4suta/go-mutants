// Package sample is a golden fixture: one comparison in ordinary statement
// context, in a file whose imports are a parenthesized block.
package sample

import (
	"fmt"
	"strings"
)

// Describe renders something about two sizes.
func Describe(a, b int) string {
	if a > b {
		return fmt.Sprint(strings.Repeat("!", a))
	}
	return "no"
}
