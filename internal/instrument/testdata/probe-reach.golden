// Package sample is a golden fixture: statements whose probe is that they ran,
// one of them holding an expression measured by a form of its own.
package sample; import __gm "example.com/mini/gomutants_rt"

// note records a step.
func note(n int) {}

// Walk calls out once per step and keeps a running total.
func Walk(limit int) int {
	total := 0
	for i := 0; i < limit; i++ {
		{ __gm.Infect(0); note(i) }
		{ __gm.Infect(1); total = func() int { var __gm_r0 int = (total + i); if __gm_r0 != (total-i) { __gm.Infect(2) }; return __gm_r0 }() }
	}
	return total
}
