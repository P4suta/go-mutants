// Package sample is a golden fixture: statements whose probe is that they ran,
// one of them holding an expression measured by a form of its own.
package sample

// note records a step.
func note(n int) {}

// Walk calls out once per step and keeps a running total.
func Walk(limit int) int {
	total := 0
	for i := 0; i < limit; i++ {
		note(i)
		total = total + i
	}
	return total
}
