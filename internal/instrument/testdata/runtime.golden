// readLimits fills Limit from the table at path, or reports why it did not.
func readLimits(path string) error {
	file, err := os.Open(path)
	if err != nil {
		return err
	}
	defer file.Close()
	scanner := bufio.NewScanner(file)
	if !scanner.Scan() || scanner.Text() != limitsHeader {
		return fmt.Errorf("the table was not written for this tree")
	}
	for scanner.Scan() {
		left, right, ok := strings.Cut(scanner.Text(), " ")
		if !ok {
			return fmt.Errorf("%q is not a site and a ceiling", scanner.Text())
		}
		site, siteErr := strconv.Atoi(left)
		if siteErr != nil || site < 0 || site >= len(Limit) {
			return fmt.Errorf("%q names no loop of this tree", left)
		}
		ceiling, ceilErr := strconv.ParseUint(right, 10, 64)
		if ceilErr != nil {
			return ceilErr
		}
		Limit[site] = ceiling
	}
	return scanner.Err()
}
