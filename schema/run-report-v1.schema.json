{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-mutants.invalid/schema/run-report-v1.schema.json",
  "title": "go-mutants run report v1",
  "description": "The lossless record of one mutation run. Everything the console, the HTML report, and the Stryker projection say is derived from this document; nothing is said anywhere that is not written down here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_type", "schema_version", "tool_version", "run_id", "status", "started_at", "finished_at", "duration_ms", "workspace", "selection", "test", "coverage", "summary", "mutants", "rejected", "skips", "expectations", "warnings"],
  "properties": {
    "document_type": { "const": "go-mutants/run-report" },
    "schema_version": { "const": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "run_id": {
      "description": "A UTC timestamp to the second and four random hex digits. It is also the name of the history file, so the shape is fixed rather than free text.",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "status": {
      "description": "completed: the run did everything it set out to do. interrupted: a signal ended it early and this is the partial record. failed: it stopped on an error, and the counts describe only what was established first.",
      "enum": ["completed", "interrupted", "failed"]
    },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "duration_ms": { "$ref": "#/$defs/milliseconds" },
    "workspace": { "$ref": "#/$defs/workspace" },
    "selection": { "$ref": "#/$defs/selection" },
    "test": { "$ref": "#/$defs/test" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "summary": { "$ref": "#/$defs/summary" },
    "mutants": { "type": "array", "items": { "$ref": "#/$defs/mutant" } },
    "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejected" } },
    "skips": { "type": "array", "items": { "$ref": "#/$defs/skip" } },
    "expectations": { "type": "array", "items": { "$ref": "#/$defs/expectation" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "milliseconds": { "type": "integer", "minimum": 0 },
    "timestamp": {
      "description": "RFC 3339 in UTC. The trailing Z is required by the pattern rather than by \"format\", which validators are free to treat as an annotation.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_path", "go_version", "workspace_digest", "platform"],
      "properties": {
        "module_path": { "type": "string", "minLength": 1 },
        "go_version": { "type": "string", "minLength": 1 },
        "workspace_digest": { "$ref": "#/$defs/digest" },
        "platform": { "$ref": "#/$defs/platform" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "description": "What was asked for, as the user asked for it, and the arithmetic of what it produced: candidates = rejected + the length of mutants[], and selected is how many of those the run set out to execute.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profile", "operators", "include", "exclude", "candidates", "rejected", "selected"],
      "properties": {
        "mode": { "enum": ["all", "mutant"] },
        "profile": { "enum": ["balanced", "strong", "all"] },
        "operators": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "candidates": { "$ref": "#/$defs/count" },
        "rejected": { "$ref": "#/$defs/count" },
        "selected": { "$ref": "#/$defs/count" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "baseline", "timeout_ms", "timeout_source"],
      "properties": {
        "command": {
          "description": "The argv vector, as written. It is executed directly and never through a shell, so it is an array and never a string.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "baseline": { "$ref": "#/$defs/baseline" },
        "timeout_ms": { "$ref": "#/$defs/milliseconds" },
        "timeout_source": { "enum": ["explicit", "derived"] }
      }
    },
    "baseline": {
      "description": "Every unmutated observation, not just the summary: runs equals the length of durations_ms, and slowest_ms is the largest of them, or 0 when there are none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "durations_ms", "slowest_ms"],
      "properties": {
        "runs": { "$ref": "#/$defs/count" },
        "durations_ms": { "type": "array", "items": { "$ref": "#/$defs/milliseconds" } },
        "slowest_ms": { "$ref": "#/$defs/milliseconds" }
      }
    },
    "coverage": {
      "description": "How coverage narrowed the run. It is an object rather than a flag so that mode can gain \"package\" — coverage-guided selection — without every consumer of this document having to learn a new top-level shape.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["off"] }
      }
    },
    "summary": {
      "description": "The counts cover every mutant in mutants[], so total equals its length. score_percent is detections over detections plus unexpected survivors, where an unexpected survivor is a survivor with no fulfilled expectation; it is null exactly when that denominator is zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "killed", "survived", "timed_out", "inconclusive", "errored", "not_run", "score_percent", "policy"],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "killed": { "$ref": "#/$defs/count" },
        "survived": { "$ref": "#/$defs/count" },
        "timed_out": { "$ref": "#/$defs/count" },
        "inconclusive": { "$ref": "#/$defs/count" },
        "errored": { "$ref": "#/$defs/count" },
        "not_run": { "$ref": "#/$defs/count" },
        "score_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "policy": {
      "description": "The gates as configured, and the first reason the run failed one of them. failure is null when nothing failed; every gate is recomputable from the counts above, so a run that failed two gates at once has not lost the second.",
      "type": "object",
      "additionalProperties": false,
      "required": ["strict", "minimum_score", "require_mutants", "failure"],
      "properties": {
        "strict": { "type": "boolean" },
        "minimum_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "require_mutants": { "type": "boolean" },
        "failure": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_id", "path", "package", "family", "rule", "rule_version", "line", "column", "start_byte", "end_byte", "original", "replacement", "outcome", "duration_ms", "killed_by", "attempts", "output_tail"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" },
        "display_id": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
        "path": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "start_byte": { "$ref": "#/$defs/count" },
        "end_byte": { "$ref": "#/$defs/count" },
        "original": { "type": "string" },
        "replacement": { "type": "string" },
        "outcome": {
          "description": "timed-out is a confirmed timeout — it timed out, was retried serially, and timed out again — and counts as a detection. A single timeout that did not reproduce is inconclusive.",
          "enum": ["killed", "survived", "timed-out", "inconclusive", "errored", "not-run"]
        },
        "duration_ms": { "$ref": "#/$defs/milliseconds" },
        "killed_by": {
          "description": "The test binary that detected the mutant — the one that failed, or the one it hung — when the harness could name it. Null for an outcome that detected nothing, and null for a detection whose output named no binary.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "attempts": {
          "description": "How many times this mutant was executed. Zero for a mutant the run never reached, one for an outcome settled first time, and two for a confirmed timeout. A not_run mutant is usually zero, but a mutant that timed out once and was interrupted before the retry could repeat it reports the one attempt it did make.",
          "$ref": "#/$defs/count"
        },
        "output_tail": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "rejected": {
      "description": "A catalogued mutant that validation refused: the instrumented snapshot did not compile with it spliced in, and the delta-debugging pass isolated it. It was never executed and is not counted in the summary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_id", "path", "line", "column", "rule", "diagnostic"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" },
        "display_id": { "type": "string", "pattern": "^[0-9a-f]{20}$" },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "diagnostic": { "type": "string", "minLength": 1 }
      }
    },
    "skip": {
      "description": "One recorded reason a site was never turned into a candidate, aggregated per file. Count is the number of suppressed candidates, or 1 for a reason that removed the whole file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason": {
          "description": "The identifiers documented in docs/operators.md. The last three are emitted by instrumentation rather than by discovery.",
          "enum": [
            "const-decl",
            "array-length",
            "type-param",
            "case-label",
            "package-var-init",
            "cgo",
            "generated",
            "excluded",
            "struct-tag",
            "label-or-goto",
            "unnameable-decl-type"
          ]
        },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "expectation": {
      "description": "One row of the [[mutation.expect]] ledger, checked against this run. fulfilled: the mutant survived, as predicted. stale: the id is not in this catalogue any more. unfulfilled: everything else — join mutants[] and rejected[] by id to see whether the tests caught it, which is the ledger lying, or whether it was simply never measured.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "state": { "enum": ["fulfilled", "unfulfilled", "stale"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^GOM[0-9]{4}$" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
